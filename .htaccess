# Production error settings (prefer php.ini or vhost config when possible)
php_value error_reporting 0
php_flag display_errors Off
php_flag display_startup_errors Off

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ==============================
# Security
# ==============================
RewriteRule (^|/)\.(?:git|svn|hg)(?:/|$) index.php?p=error404 [L,NC,QSA]
RewriteRule ^\.github(?:/|$) index.php?p=error404 [L,NC,QSA]
RewriteRule (^|/)(?:\.(?:gitignore|gitattributes|env(?:\..*)?)|config\.env(?:\..*)?)$ index.php?p=error404 [L,NC,QSA]
RewriteRule ^app(?:/|$) index.php?p=error404 [L,NC,QSA]

# Block only real internal files/directories under /tools and /sql.
# Virtual application routes such as /tools/forum-topic-viewer must still reach the front controller.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(?:tools|sql)(?:/|$) index.php?p=error404 [L,NC,QSA]

RewriteRule (^|/)admin_docs(?:/|$) index.php?p=error404 [L,NC,QSA]
RewriteRule (^|/)(?:README|TECHNICAL_DOCUMENTATION|TELEGRAM_BOT_BACKEND_GUIDE)\.md$ index.php?p=error404 [L,NC,QSA]
RewriteRule (^|/)(?:composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|dump-[^/]+\.sql|check_encoding\.ps1)$ index.php?p=error404 [L,NC,QSA]
RewriteRule (^|/)admin_upgrade_notes(?:/|$) index.php?p=error404 [L,NC,QSA]

# Block executable/script payloads from public asset/upload trees.
# Keep this before the existing-file short circuit and /img alias.
RewriteRule ^(?:public/)?img/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$ index.php?p=error404 [L,NC,QSA]

# ==============================
# Existing files and folders
# ==============================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==============================
# Aliases to /public
# ==============================
RewriteRule ^img/(.*)$ public/img/$1 [L]
RewriteRule ^sounds/(.*)$ public/sounds/$1 [L]
# ==============================
# Front controller
# ==============================
RewriteRule ^ index.php [L,QSA]

</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
